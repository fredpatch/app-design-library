{
  "name": "app-design-library",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:components": "node scripts/audit-components.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:storybook": "npm run build --workspace=apps/storybook",
    "dev": "npm run dev --workspace=apps/storybook",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run format:check && npm run lint && npm run audit:components && npm run typecheck && npm run build && npm run build:storybook"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
