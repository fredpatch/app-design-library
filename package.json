{
  "name": "app-design-library",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:components": "node scripts/audit-components.mjs",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=apps/storybook",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
